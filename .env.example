# Public site URL used for canonical URLs, sitemap, Open Graph and JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tools.zspace.in

# Public contact address shown on /contact, the footer and llms.txt.
NEXT_PUBLIC_CONTACT_EMAIL=connect@zspace.in

# Analytics. Every tool works without them.
# GTM defaults to the ZSpace container (GTM-PXPCMNMB); set to an empty value to disable.
# GA4 is configured inside GTM — only set NEXT_PUBLIC_GA_ID if GTM is disabled.
NEXT_PUBLIC_GTM_ID=GTM-PXPCMNMB
NEXT_PUBLIC_GA_ID=

# Optional Google Search Console HTML-tag verification token (content="...").
NEXT_PUBLIC_GSC_VERIFICATION=

# In-browser processing limits, in megabytes.
NEXT_PUBLIC_MAX_IMAGE_MB=25
NEXT_PUBLIC_MAX_IMAGES=30
NEXT_PUBLIC_MAX_PDF_MB=100
NEXT_PUBLIC_MAX_PDF_FILES=30
NEXT_PUBLIC_MAX_MERGE_MB=250
